# OpenAI API key — used for ambiguous PDF classification and line-item normalization
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-REPLACE_ME

# Cheap + fast model for deterministic tasks (classification, mapping)
OPENAI_CLASSIFIER_MODEL=gpt-4o-mini
OPENAI_NORMALIZER_MODEL=gpt-4o-mini
# Discovery + AI-verify benefit from a stronger model — better factual recall
# of tickers, exchanges, and IR URL patterns. Drop to gpt-4o if you don't have
# gpt-5 access.
OPENAI_DISCOVER_MODEL=gpt-5
# Vision-LLM model — reads PDF page images directly when Docling/pdfplumber
# fail the verifier. gpt-4o is the cheaper fallback at the cost of accuracy.
OPENAI_VLM_MODEL=gpt-5
# Label-drift mapper for normalize. gpt-4o-mini is too conservative on
# synonyms (older reports' label conventions don't survive its verbatim
# match rule). gpt-5 fixes this; ~5–10 calls per company.
OPENAI_DRIFT_MODEL=gpt-5

# Tavily web-search key — when set, `report-scrape discover` grounds each company's
# scrape config in real PDF URLs (vs. trusting LLM-guessed paths). Optional
# but strongly recommended; the free tier covers occasional discovery runs.
# Get a key at https://app.tavily.com/.
TAVILY_API_KEY=

# Data paths (relative to repo root)
REPORT_SCRAPE_DATA_DIR=./data
REPORT_SCRAPE_RAW_DIR=./data/raw
REPORT_SCRAPE_CACHE_DIR=./data/cache
REPORT_SCRAPE_EXPORTS_DIR=./data/exports
REPORT_SCRAPE_DUCKDB_PATH=./data/report-scrape.duckdb

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console          # "console" for dev, "json" for CI / prod

# Scraper manners
SCRAPER_USER_AGENT=report-scrape/0.1 (+contact: your-email@example.com)
SCRAPER_TIMEOUT=30
SCRAPER_MAX_RETRIES=3
